<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.github.apz.sample.mapper.ItemMapper">
    <resultMap id="itemResultMap" type="com.github.apz.sample.model.ItemRecord">
	    <constructor>
            <idArg column="item_id" javaType="int"/>
            <arg column="item_name" javaType="String"/>
            <arg column="stock" javaType="int"/>
        </constructor>
    </resultMap>
    
    <select id="findStocks" resultMap="itemResultMap">    	
        SELECT 
          item_id
          , item_name
          , stock 
        FROM 
          item_stock
    </select>

    <select id="findById" resultMap="itemResultMap">
        SELECT 
          item_id
          , item_name
          , stock 
        FROM 
          item_stock
        WHERE
          item_id = #{itemId}
    </select>
</mapper>